# 개발 서버(npm run dev)가 /api 요청을 전달할 백엔드 주소
VITE_PROXY_TARGET=http://localhost:8000

# 백엔드에 직접 요청할 베이스 URL (선택)
# 비워 두면 같은 출처의 /api로 요청한다. 빌드 결과물을 백엔드와 다른 출처에서 서빙할 때만 설정한다.
# 이 경우 백엔드 CORS에서 allow_origins와 expose_headers=["X-Total-Count"]를 열어야 한다.
# VITE_API_BASE=https://api.example.com

# 대시보드를 백엔드 없이 목데이터로 띄운다 (개발/시연용)
# VITE_USE_MOCK=true
